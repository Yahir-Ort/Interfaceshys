## Código de Emisor ##

/*
  PROYECTO TUXTTER - NODO TRANSMISOR (DIFFUSION)
  Envía ráfagas de datos de forma abierta sin requerir direccionamiento MAC.
  Diseñado para pruebas de rendimiento de antenas en campo.
*/
#include <WiFi.h>
#include <esp_now.h>

// Estructura de transmisión de datos protegida
typedef struct __attribute__((packed)) {
  uint32_t ID_secuencia;
} BloqueDatos;

const uint8_t DIRECCION_DIFUSION[6] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
uint32_t contador_envios = 0;

void setup() {
  Serial.begin(115200);
  
  // Inicialización del entorno de radiofrecuencia
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  
  if (esp_now_init() != ESP_OK) {
    Serial.println("[PROYECTO TUXTTER] Error crítico: No se pudo iniciar el protocolo inalámbrico.");
    while (true) delay(1000);
  }
  
  // Registro y configuración del enlace abierto (Peer)
  esp_now_peer_info_t configuracion_enlace = {};
  memcpy(configuracion_enlace.peer_addr, DIRECCION_DIFUSION, 6);
  configuracion_enlace.channel = 1; // Canal fijo de transmisión
  configuracion_enlace.ifidx = WIFI_IF_STA;
  configuracion_enlace.encrypt = false;
  
  esp_now_add_peer(&configuracion_enlace);
  Serial.println("=== PROYECTO TUXTTER: Transmisor Inicializado Core OK ===");
}

void loop() {
  BloqueDatos paquete_actual = { contador_envios++ };
  
  // Despacho del paquete de datos al espacio de radio
  esp_err_t estado_transmision = esp_now_send(DIRECCION_DIFUSION, (uint8_t *)&paquete_actual, sizeof(paquete_actual));
  
  // Reporte periódico en consola cada 25 envíos para no saturar el buffer
  if (contador_envios % 25 == 0) {
    Serial.print("[PROYECTO TUXTTER] Muestras enviadas al aire: ");
    Serial.print(contador_envios);
    Serial.print(" | Estado del bus: ");
    Serial.println(estado_transmision == ESP_OK ? "ACTIVO" : "FALLO");
  }
  
  delay(200); // Mantiene la tasa fija de 5 paquetes por segundo
}






## Código de Receptor ##

/*
  PROYECTO TUXTTER - NODO RECEPTOR (ESCUCHA)
  Captura las ráfagas de datos en el aire y evalúa la potencia de enlace (RSSI).
*/
#include <WiFi.h>
#include <esp_now.h>

// La estructura de datos interna debe acoplarse con el emisor
typedef struct __attribute__((packed)) {
  uint32_t ID_secuencia;
} BloqueDatos;

#define PIN_TEST_LED 2 // Canal físico para control visual por LED

// Callback de hardware ejecutado al recibir tramas de radio válidas
void interceptarFlujoDatos(const esp_now_recv_info_t *metadatos_enlace, const uint8_t *datos_crudos, int dimension) {
  BloqueDatos datos_procesados;
  
  // Reconstrucción del paquete binario
  memcpy(&datos_procesados, datos_crudos, sizeof(datos_procesados));
  
  // Extracción del valor de decibelios recibidos (RSSI)
  int16_t ganancia_rssi = metadatos_enlace->rx_ctrl.rssi;

  // Renderizado de lecturas en el Monitor Serie
  Serial.printf("[TUXTTER - DATOS DETECTADOS] -> Registro: #%lu | Nivel de Red: %d dBm\n", (unsigned long)datos_procesados.ID_secuencia, ganancia_rssi);

  // Pulso inverso del indicador lumínico para registrar el evento de llegada
  digitalWrite(PIN_TEST_LED, LOW);
  delay(20);
  digitalWrite(PIN_TEST_LED, HIGH);
}

void setup() {
  Serial.begin(115200);
  
  // Seteo del LED indicador en modo escucha permanente
  pinMode(PIN_TEST_LED, OUTPUT);
  digitalWrite(PIN_TEST_LED, HIGH);
  
  // Activación del receptor Wi-Fi en modo limpio
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  if (esp_now_init() != ESP_OK) {
    Serial.println("[PROYECTO TUXTTER] Falla fatal: Capa de red inalámbrica deshabilitada.");
    while (true) {
      digitalWrite(PIN_TEST_LED, !digitalRead(PIN_TEST_LED));
      delay(150); // Alerta visual de error en hardware
    }
  }

  // Enlace de la función destructora de paquetes al bus de recepción
  esp_now_register_recv_cb(esp_now_recv_cb_t(interceptarFlujoDatos));
  
  Serial.println("=== PROYECTO TUXTTER: Nodo Receptor Escuchando Frecuencias Abiertas ===");
}

void loop() {
  // El bucle cíclico se mantiene en espera pasiva por interrupciones
}
